# Telegram
BOT_TOKEN=your_telegram_bot_token_here
ADMIN_IDS=123456789,987654321
WEBHOOK_SECRET=change_me_to_random_secret

# Database
DATABASE_URL=postgresql+asyncpg://musicsave:musicsave@localhost:5432/musicsave

# Redis
REDIS_URL=redis://localhost:6379/0

# External APIs
# AudD music recognition — https://dashboard.audd.io/
AUDD_API_TOKEN=your_audd_api_token_here

# Optional: YouTube Data API for official video search — https://console.cloud.google.com/
YOUTUBE_API_KEY=

# App
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=true
RATE_LIMIT_PER_MINUTE=30
MAX_MEDIA_SIZE_MB=20
